  "scenes": {
    "pro_01": {
      "chapter": "序章・一",
      "title": "暁の銃声",
      "location": "天正十年 六月二日 暁 ― 本能寺・奥座敷",
      "bg": "bg_honnoji_fire",
      "bgm": "tension_low",
      "effect": "embers",
      "lines": [
        {
          "speaker": "",
          "text": "最初は、朝霧を切り裂く雷鳴かと思った。だが、鼓膜を震わせたのは紛れもない火縄銃の轟音。続いて怒号と刃の音が、静寂だったはずの寺の境内を飲み込んでいく。",
          "se": "gunshot",
          "shake": true,
          "flash": "white",
          "sprites": []
        },
        {
          "speaker": "森蘭丸",
          "text": "「上様！ 敵襲にございます！ 大軍が寺の四方を完全に包囲しております！」",
          "se": "door_slam",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": false },
            { "id": "ranmaru_normal", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「兵の数は。旗印は何だ」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": true },
            { "id": "ranmaru_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "森蘭丸",
          "text": "「およそ一万三千！ 旗は……水色に桔梗紋！ 明智日向守の軍勢にございます！」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": false },
            { "id": "ranmaru_normal", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「……光秀か」",
          "bgm": "silence",
          "se": "fire_roar",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": true },
            { "id": "ranmaru_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "脳裏に浮かんだのは、数日前に安土で茶を喫した折の、あの男の穏やかな微笑みだった。",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": false },
            { "id": "mitsuhide_normal", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "",
          "text": "無理難題を押し付けた覚えはある。だが、天下布武という同じ夢の頂を見ていたはずの男が、なぜ今、この暁に刃を向ける。"
        },
        {
          "speaker": "織田信長",
          "text": "「是非に及ばず――」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": true },
            { "id": "ranmaru_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "口をついて出たその言葉を、俺は奥歯で噛み潰した。（否。及ばぬはずがあるか。日ノ本を変える大業は、まだ半ばだぞ……！）"
        },
        {
          "speaker": "森蘭丸",
          "text": "「御意。ならばこの蘭丸、命に代えても上様を炎の外へお通しいたします！」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": false },
            { "id": "ranmaru_normal", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "",
          "text": "俺は傍らの弓と槍を掴み取り、紅蓮の煙が立ち込める回廊へと踏み出した。血路は、この手で切り開く。"
        }
      ],
      "next": "pro_02"
    },
    "pro_02": {
      "chapter": "序章・二",
      "title": "紅蓮の決別",
      "location": "天正十年 六月二日 早朝 ― 炎上する回廊",
      "bg": "bg_honnoji_fire",
      "bgm": "battle_intense",
      "effect": "embers",
      "lines": [
        {
          "speaker": "弥助",
          "text": "「上様、こちらへ！ 裏手の井戸の脇に、南蛮寺へ抜ける古い地下水路がございます！」",
          "sprites": [
            { "id": "yasuke_combat", "pos": "left", "active": true },
            { "id": "ranmaru_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "黒い巨躯が降り注ぐ矢の雨を体ごと受け止め、突進で敵陣を砕く。その背を追い、俺もまた長槍を振るって迫る明智兵を薙ぎ払う。",
          "se": "sword_slash",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": true },
            { "id": "yasuke_combat", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "だが黒煙が視界を奪い、退路の角から新たな槍隊と鉄砲衆が雪崩れ込んできた。"
        },
        {
          "speaker": "森蘭丸",
          "text": "「――ここは私が食い止めます！」",
          "sprites": [
            { "id": "yasuke_combat", "pos": "left", "active": false },
            { "id": "ranmaru_smile", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "",
          "text": "炎に照らされた若き小姓は、振り返りもせず愛用の十文字槍の石突きを床に打ち付けた。"
        },
        {
          "speaker": "森蘭丸",
          "text": "「上様より賜りしこの十文字槍、今こそ使い時にございます！ 一歩たりとも通しはせぬ！」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": false },
            { "id": "ranmaru_smile", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「蘭丸、貴様……！」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": true },
            { "id": "ranmaru_smile", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "森蘭丸",
          "text": "「『是非に及ばず』などとは仰いますな。上様の天下は、この先にあるのです！ 弥助殿、上様を頼む！」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": false },
            { "id": "ranmaru_smile", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "弥助",
          "text": "「……承知した、蘭丸殿！ 上様、お許しを！」",
          "sprites": [
            { "id": "yasuke_combat", "pos": "left", "active": true },
            { "id": "ranmaru_smile", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「待て、蘭丸！ 死ぬな――！」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": true },
            { "id": "ranmaru_smile", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "燃え落ちる梁が二人の間を隔てた。紅蓮の向こうで槍を構え直す影が見えた瞬間、弥助の太い腕が俺を抱え上げ、暗い水路の闇へと飛び込んだ。",
          "se": "crash_fire",
          "shake": true,
          "flash": "red",
          "sprites": []
        }
      ],
      "next": "pro_03"
    },
    "pro_03": {
      "chapter": "序章・三",
      "title": "灰と朝霧の決断",
      "location": "天正十年 六月二日 朝 ― 京の外れ・竹林",
      "bg": "bg_kyoto_bamboo",
      "bgm": "quiet_resolve",
      "effect": "mist",
      "lines": [
        {
          "speaker": "",
          "text": "冷たい泥水にまみれ、地下水路を這い抜けた俺たちが辿り着いたのは、京の西外れにある無人の竹林だった。東の空には、本能寺を焼き尽くす黒煙が立ち昇っている。",
          "se": "water_escape",
          "sprites": []
        },
        {
          "speaker": "弥助",
          "text": "「……ご無事でございますか、上様。すぐにお傷の手当てを」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": false },
            { "id": "yasuke_combat", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「左肩を浅く切られた程度だ。それより貴様、なぜそこまでする。異国から来た貴様には、逃げる道もあったはずだ」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": true },
            { "id": "yasuke_combat", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "弥助",
          "text": "「上様は、肌の色も言葉も違う私を『人』として、武士として遇してくださいました。この命、上様と共にございます」",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": false },
            { "id": "yasuke_combat", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "",
          "text": "弥助の真っ直ぐな眼差しに、俺は静かに頷き、京の方角へ視線を戻した。"
        },
        {
          "speaker": "弥助",
          "text": "「明智の兵たちは『信長様を討ち取った』と勝ち鬨を上げておりました。あの炎では、誰もが上様の死を信じるでしょう」"
        },
        {
          "speaker": "",
          "text": "世間は今、織田信長が死んだと思っている。『信長』という巨大な重石が消えた時、日ノ本中の野心が音を立てて動き出す。",
          "sprites": [
            { "id": "nobunaga_wounded", "pos": "left", "active": true },
            { "id": "yasuke_combat", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "数日のうちに、この報せは備中で毛利と対峙する羽柴秀吉のもとへも、越後の上杉と睨み合う柴田勝家のもとへも届くはずだ。"
        },
        {
          "speaker": "",
          "text": "（俺が死んだと知った時、奴らは何を思う？ 主君の仇を討つか、それとも――「次は俺の天下だ」とほくそ笑むか？）"
        },
        {
          "speaker": "",
          "text": "蘭丸が繋いだこの命、無駄にはできぬ。覇王として直ちに旗を翻すか、それとも闇に潜み家臣たちの本性を見定めるか。"
        },
        {
          "speaker": "",
          "text": "朝霧が晴れ、冷たい陽光が顔を照らす。焼け焦げた羽織を脱ぎ捨てた俺は、ゆっくりと目を開けた。"
        }
      ],
      "choicePrompt": "弥助「上様、いかがなされますか。これよりどこへ向かいましょう」",
      "choices": [
        {
          "label": "即座に生存を知らせ、光秀を正面から叩き潰す",
          "sub": "摂津の諸将のもとへ駆け込み、覇王の帰還を宣言して討伐の兵を挙げる",
          "target": "routeA_01"
        },
        {
          "label": "「信長は死んだ」ままにしておく",
          "sub": "死を偽装したまま潜伏し、家臣たちの本音を見極めてから動く",
          "target": "routeB_01"
        }
      ]
    },
    "routeA_01": {
      "chapter": "覇道篇・一",
      "title": "覇王の帰還",
      "location": "天正十年 六月四日 ― 大坂・織田本陣の広間",
      "bg": "bg_osaka_council",
      "bgm": "march_heroic",
      "effect": "none",
      "lines": [
        {
          "speaker": "",
          "text": "本能寺の炎をくぐり抜けてから、わずか二日。俺は弥助と共に摂津へ駆け込み、四国攻めを控えていた三男・信孝と丹羽長秀の軍勢と合流した。",
          "se": "war_horn",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": false },
            { "id": "yasuke_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "死んだはずの主君が、傷一つ隠さず床几に腰を下ろした瞬間、広間に集まった諸将の顔から血の気が引いた――そして次の瞬間、狂気にも似た歓声が爆発した。"
        },
        {
          "speaker": "織田信長",
          "text": "「――全軍に伝えよ。織田上総介信長、ここに在り。逆賊・明智光秀の首を刎ね、本能寺に散った蘭丸らの魂に捧げる！」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": true },
            { "id": "yasuke_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "数万の兵による地鳴りのような勝鬨が天地を揺らす。『信長生存』の報せは、疾風のように畿内を駆け巡った。",
          "se": "battle_cry",
          "shake": true
        },
        {
          "speaker": "",
          "text": "光秀の誘いに乗ろうとしていた細川藤孝も、筒井順慶も、恐怖に震えながら即座に織田方へ参陣を表明する。もはや明智の軍勢は、袋の鼠だった。"
        },
        {
          "speaker": "弥助",
          "text": "「上様、山崎への先鋒が整いました。それと……西国より早馬が。備中の羽柴秀吉殿が毛利と和睦し、凄まじい速さで京へ迫っております」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": false },
            { "id": "yasuke_normal", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「ほう……あの距離を、毛利との講和まで済ませて引き返してくるだと？」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": true },
            { "id": "yasuke_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "（忠義のゆえか、それとも――『俺を討った光秀』を自らの手で討ち、天下を拾い上げるためか）"
        },
        {
          "speaker": "",
          "text": "俺は陣太刀の柄を握りしめ、雨雲の垂れ込める山崎へと馬を進めた。"
        }
      ],
      "next": "routeA_02"
    },
    "routeA_02": {
      "chapter": "覇道篇・二",
      "title": "山崎の霧と野心",
      "location": "天正十年 六月十三日 夕刻 ― 山崎・本陣",
      "bg": "bg_yamazaki_camp",
      "bgm": "sorrow_confrontation",
      "effect": "rain",
      "lines": [
        {
          "speaker": "",
          "text": "六月十三日、山崎。戦いは半日も経たずに決した。敗走の途上で捕らえられ、深手を負って引き据えられた男は、血にまみれながらも澄んだ目をしていた。",
          "sprites": []
        },
        {
          "speaker": "織田信長",
          "text": "「……光秀。貴様ほどの男が、なぜ勝算の薄い謀反に走った」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": true },
            { "id": "mitsuhide_injured", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "明智光秀",
          "text": "「上様。貴方様は、あまりにも速すぎました」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": false },
            { "id": "mitsuhide_injured", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「何？」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": true },
            { "id": "mitsuhide_injured", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "明智光秀",
          "text": "「古い神仏を焼き、民も家臣も休ませぬまま次の戦へ駆り立てる……。このままでは日ノ本は修羅の獄となり、やがて南蛮の黒船に国ごと呑まれます」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": false },
            { "id": "mitsuhide_injured", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "明智光秀",
          "text": "「私はただ、一度でいいから――『人間としての信長様』を止めたかったのです」"
        },
        {
          "speaker": "織田信長",
          "text": "「……愚かな。南蛮の波を恐れるならなおさら、旧き世を叩き壊して誰よりも速く走るしかなかったのだ」",
          "sprites": [
