            { "id": "nobunaga_normal", "pos": "left", "active": false },
            { "id": "sokyu_fan", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「世話になったな、宗久。あとは秀吉の猿をうまく手綱で操っておけ」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": true },
            { "id": "sokyu_fan", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "弥助",
          "text": "「上様！ 南蛮の航海士たちが帆を張り終えました。風は最高にございます！」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": false },
            { "id": "yasuke_joy", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「ふっ、光秀の奴が草葉の陰で目を丸くしていよう。――抜錨せよ！」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": true },
            { "id": "yasuke_joy", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「日ノ本など、世界のほんの片隅に過ぎぬ！ ルソンも、天竺も、イスパニアも――この俺が、その目で確かめてくれるわ！」"
        },
        {
          "speaker": "弥助",
          "text": "「はい！ どこまでもお供いたします、我が主よ！」",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": false },
            { "id": "yasuke_joy", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "",
          "text": "本能寺で一度死んだ男は、蘭丸の遺した命を胸に海を渡り、新たな伝説となった。",
          "sprites": [
            { "id": "nobunaga_normal", "pos": "left", "active": true },
            { "id": "yasuke_joy", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "水平線の彼方へ突き進む船首で、第六天魔王はかつてないほど自由に笑っていた。"
        }
      ],
      "ending": {
        "id": "END_2",
        "number": "弐",
        "title": "大海原の覇王",
        "subtitle": "【ロマンエンド】島国の覇権を捨て、未知の世界へ船出した新伝説"
      }
    },
    "routeB_01": {
      "chapter": "暗躍篇・一",
      "title": "亡霊の茶室",
      "location": "天正十年 六月十四日 ― 堺・今井宗久の隠し屋敷",
      "bg": "bg_sakai_tearoom",
      "bgm": "mystery_koto",
      "effect": "none",
      "lines": [
        {
          "speaker": "",
          "text": "本能寺の炎を逃れた俺と弥助は、京の商人の手引きで自由都市・堺へと潜伏した。茶の師であり鉄砲と南蛮貿易の盟友でもある、豪商・今井宗久の隠し屋敷。",
          "se": "shishi_odoshi",
          "sprites": []
        },
        {
          "speaker": "",
          "text": "世間では『織田信長は本能寺の灰と消えた』と信じ込まれ、俺は名のなき浪人として、日ノ本が激変していく様をただ静かに眺めていた。"
        },
        {
          "speaker": "今井宗久",
          "text": "「――本日の早馬にございます、上様。昨日、山崎にて羽柴筑前守殿が明智光秀を討ち取りました」",
          "sprites": [
            { "id": "nobunaga_ronin", "pos": "left", "active": false },
            { "id": "sokyu_normal", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「……早いな。備中で毛利と戦っていたはずの猿が、わずか十日余りで戻ったか」",
          "sprites": [
            { "id": "nobunaga_ronin", "pos": "left", "active": true },
            { "id": "sokyu_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "今井宗久",
          "text": "「それだけではございませぬ。秀吉殿はすでに『上様の仇を討った唯一の忠臣』と名乗り、丹羽様や池田様を取り込んで織田家の実権を握りつつあります」",
          "sprites": [
            { "id": "nobunaga_ronin", "pos": "left", "active": false },
            { "id": "sokyu_fan", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "今井宗久",
          "text": "「柴田勝家様とは一触即発の有様。……まるで、最初からこうなる筋書きを書いていたかのような手際でございますな」"
        },
        {
          "speaker": "弥助",
          "text": "「上様！ 今すぐ堺の鉄砲衆を率いて京へ上りましょう。上様が生きておられると知れば、秀吉殿もひれ伏すはず！」",
          "sprites": [
            { "id": "nobunaga_ronin", "pos": "left", "active": false },
            { "id": "yasuke_normal", "pos": "right", "active": true }
          ]
        },
        {
          "speaker": "織田信長",
          "text": "「慌てるな、弥助。死んだはずの主君を前に、忠臣の仮面がどこまで剥がれるか――もう少し見物させろ」",
          "sprites": [
            { "id": "nobunaga_ronin", "pos": "left", "active": true },
            { "id": "yasuke_normal", "pos": "right", "active": false }
          ]
        },
        {
          "speaker": "",
          "text": "俺は茶碗の底に映る己の顔を見つめ、静かに茶を啜った。苦味が、やけに心地よかった。"
        },
        {
          "speaker": "",
          "text": "やがて織田家の後継を決める会議が尾張・清洲で開かれると聞き、俺たちは闇に紛れて故郷へと向かった。"
        }
      ],
      "next": "routeB_02"
