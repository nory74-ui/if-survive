      "lines": [
        {
          "speaker": "織田信長",
          "text": "「ハハハハッ！ 来い、猿！ 丹羽！ 池田！ 貴様ら全員、この俺が取り立ててやった犬どもではないか！」",
          "se": "armor_march",
          "sprites": [
            { "id": "nobunaga_ronin", "pos": "left", "active": true },
            { "id": "yasuke_combat", "pos": "right", "active": false }
